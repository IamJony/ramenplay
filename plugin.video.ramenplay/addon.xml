<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.ramenplay"
       name="RamenPlay"
       version="1.8.0"
       provider-name="IamJony">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="inputstream.adaptive" version="2.4.0" optional="true"/>
        <import addon="script.module.streamvid" version="1.0.3"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="es">Anime en streaming</summary>
        <description lang="es">RamenPlay — Reproductor de anime con health check de servidores.</description>
        <platform>all</platform>
        <license>GPL-2.0</license>
        <source>https://github.com/IamJony</source>
    </extension>
</addon>
